{
  "manifest_version": 2,
  "name": "Orbit Web",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "orbitweb@orbit.app"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "exclude_matches": [
        "*://consent.youtube.com/*"
      ],
      "css": [
        "yt.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}